# Admin password for /admin (empty = default "portfolio-admin" in development)
ADMIN_PASSWORD=

# HMAC secret for admin session cookies (empty = a random per-process secret,
# which signs everyone out on restart)
ADMIN_SESSION_SECRET=

# Directory for the JSON stores (defaults to ./data)
PORTFOLIO_DATA_DIR=

# AI assistant provider: "anthropic" (default) or "ollama"
AI_PROVIDER=ollama

# Anthropic — required when AI_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com — billed per request.
ANTHROPIC_API_KEY=

# Ollama — used when AI_PROVIDER=ollama.
# Cloud models (:cloud suffix) run on ollama.com and need a signed-in daemon
# ("ollama signin") or an OLLAMA_API_KEY below.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
OLLAMA_API_KEY=
